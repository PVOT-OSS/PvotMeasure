From 8114bf2609a18413c562979c5bb2b7faad49892a Mon Sep 17 00:00:00 2001
From: Shivansh Pandey <shivanshp987@gmail.com>
Date: Sat, 31 Oct 2026 17:57:23 +0530
Subject: [PATCH 2/3] branding: Draw the main launcher icon on the Veyra
 background

Assisted-By: LLM
Signed-off-by: Shivansh Pandey <shivanshp987@gmail.com>
---
 .../android/java/res_base/drawable/ic_launcher.xml |  7 +++++++
 branding/icon/generate.py                          | 14 ++++++++++++++
 2 files changed, 21 insertions(+)
 create mode 100644 branding/icon/chromium/chrome/android/java/res_base/drawable/ic_launcher.xml

diff --git a/branding/icon/chromium/chrome/android/java/res_base/drawable/ic_launcher.xml b/branding/icon/chromium/chrome/android/java/res_base/drawable/ic_launcher.xml
new file mode 100644
index 0000000..85bad35
--- /dev/null
+++ b/branding/icon/chromium/chrome/android/java/res_base/drawable/ic_launcher.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Generated by veyra/branding/icon/generate.py; edit that, not this. -->
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@mipmap/layered_app_icon_background"/>
+    <foreground android:drawable="@mipmap/layered_app_icon"/>
+    <monochrome android:drawable="@drawable/themed_app_icon"/>
+</adaptive-icon>
diff --git a/branding/icon/generate.py b/branding/icon/generate.py
index 9e27490..9f48a83 100644
--- a/branding/icon/generate.py
+++ b/branding/icon/generate.py
@@ -100,6 +100,17 @@ def render_foreground(size, tile=72 / 108, supersample=4):
 # Chromium's launcher icon, by density: legacy icon 48dp, adaptive layers 108dp.
 DENSITIES = {"mdpi": 1, "hdpi": 1.5, "xhdpi": 2, "xxhdpi": 3, "xxxhdpi": 4}
 CHROMIUM_RES = "chrome/android/java/res_chromium_base"
+# Chromium's main launcher icon (android:icon) puts its foreground on white, which hides a white
+# ring; this one uses the round icon's background instead.
+LAUNCHER_ICON = "chrome/android/java/res_base/drawable/ic_launcher.xml"
+LAUNCHER_ICON_XML = """<?xml version="1.0" encoding="utf-8"?>
+<!-- Generated by veyra/branding/icon/generate.py; edit that, not this. -->
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@mipmap/layered_app_icon_background"/>
+    <foreground android:drawable="@mipmap/layered_app_icon"/>
+    <monochrome android:drawable="@drawable/themed_app_icon"/>
+</adaptive-icon>
+"""
 
 
 def chromium_assets(out):
@@ -129,6 +140,9 @@ def chromium_assets(out):
     os.makedirs(os.path.join(res, "drawable"), exist_ok=True)
     with open(os.path.join(res, "drawable", "themed_app_icon.xml"), "w") as f:
         f.write(layers["ic_veyra_monochrome.xml"])
+    os.makedirs(os.path.dirname(os.path.join(out, LAUNCHER_ICON)), exist_ok=True)
+    with open(os.path.join(out, LAUNCHER_ICON), "w") as f:
+        f.write(LAUNCHER_ICON_XML)
 
 
 def svg(size=1024):
